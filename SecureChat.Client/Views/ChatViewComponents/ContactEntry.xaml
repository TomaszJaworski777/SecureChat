<UserControl x:Class="SecureChat.Client.Views.ChatViewComponents.ContactEntry"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Button Background="Transparent" BorderThickness="0"
            HorizontalContentAlignment="Stretch" Padding="15,8,10,8" Margin="0,0,0,0" Width="260" Click="Button_Click">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="35" Height="35" Margin="0,0,10,0">
                <Ellipse x:Name="Avatar"/>
                <TextBlock x:Name="InitialText" FontSize="16"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse x:Name="OnlineIndicator" Width="12" Height="12"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Stroke="#202020" Fill="#4CAF50" StrokeThickness="2" Visibility="Collapsed"/>
            </Grid>

            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock x:Name="UsernameText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LastMessageDateText" FontSize="11" Opacity="0.5"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock x:Name="LastMessageText" Grid.Row="1" FontSize="12"
                           Opacity="0.5" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Grid>
    </Button>
</UserControl>
