<UserControl x:Class="SecureChat.Client.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <StackPanel Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Create the new account" FontSize="24" FontWeight="Bold"
                HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <TextBlock Text="Username" FontSize="12" Opacity="0.7" Margin="0,0,0,6"/>
            <ui:TextBox x:Name="UsernameBox" PlaceholderText="Enter your username" Margin="0,0,0,16">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Person24"/>
                </ui:TextBox.Icon>
            </ui:TextBox>

            <TextBlock Text="Password" FontSize="12" Opacity="0.7" Margin="0,0,0,6"/>
            <ui:PasswordBox x:Name="PasswordBox" PlaceholderText="Enter your password" Margin="0,0,0,12">
                <ui:PasswordBox.Icon>
                    <ui:SymbolIcon Symbol="Key24"/>
                </ui:PasswordBox.Icon>
            </ui:PasswordBox>
            <ui:PasswordBox x:Name="RepeatPasswordBox" PlaceholderText="Repeat your password" Margin="0,0,0,28">
                <ui:PasswordBox.Icon>
                    <ui:SymbolIcon Symbol="Key24"/>
                </ui:PasswordBox.Icon>
            </ui:PasswordBox>

            <ui:Button Content="REGISTER" Appearance="Primary"
           HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
           Padding="0,10" FontWeight="SemiBold" Margin="0,0,0,12" Click="Register_Click"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Already have an account?" Opacity="0.5" FontSize="12" VerticalAlignment="Center"/>
                <ui:Button Content="Sign in" Appearance="Transparent" Padding="6,1,6,2" BorderThickness="0" Margin="3,0,0,0" CornerRadius="10"
               FontSize="12" Click="SignIn_Click"/>
            </StackPanel>
            
        </StackPanel>
    </Grid>
</UserControl>
