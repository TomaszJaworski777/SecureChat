<ui:FluentWindow x:Class="SecureChat.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:SecureChat.Client"
        mc:Ignorable="d"
        Focusable="False"
        Title="MainWindow" Height="750" Width="1010" MinWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Title="SecureChat" Padding="7" Height="30" Foreground="#777" Grid.Row="0" Focusable="False"/>
        <ContentControl x:Name="MainContent" Grid.Row="1" Focusable="False"/>
    </Grid>
</ui:FluentWindow>
